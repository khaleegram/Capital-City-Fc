rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff are users with a document at admins/{uid}.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function isPublished() {
      return resource.data.published == true;
    }

    // ───────── Staff accounts ─────────
    match /admins/{uid} {
      // A user may read their own record (used by AdminGuard and server-side staff checks).
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isOwner()
        && request.resource.data.role in ['owner', 'editor'];
      // Owners can't delete themselves, so there's always at least one owner.
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // ───────── Always-public collections ─────────
    match /players/{playerId} {
      // Unpublished drafts hold date of birth and the signupSessionId that unlocks the
      // player's staged files, so they must never be world-readable. A list query must
      // therefore carry a `published == true` constraint (rules are not filters) — see
      // src/lib/server/queries.ts.
      allow read: if resource.data.published == true || isAdmin();

      // Validates one club-history entry. The create rule below applies this in full to the
      // first entry, and the cheaper `verified == false` check to the remaining indices —
      // see the note there for why. Keep in sync with src/lib/player-signup.ts.
      function validClubEntry(e) {
        return e is map
          && e.keys().hasAll(['club', 'current', 'verified'])
          && e.keys().hasOnly([
              'club', 'league', 'division', 'country', 'seasons', 'current', 'level',
              'appearances', 'goals', 'assists', 'position', 'verified'])
          && e.club is string && e.club.size() >= 1 && e.club.size() <= 80
          && e.current is bool
          // A player can never mark their own claim as confirmed.
          && e.verified == false
          && (!('league' in e) || (e.league is string && e.league.size() <= 80))
          && (!('division' in e) || (e.division is string && e.division.size() <= 60))
          && (!('country' in e) || (e.country is string && e.country.size() <= 60))
          && (!('seasons' in e) || (e.seasons is string && e.seasons.size() <= 40))
          && (!('level' in e) || e.level in ['Youth', 'Academy', 'Senior'])
          && (!('position' in e) || e.position in ['Goalkeeper', 'Defender', 'Midfielder', 'Forward'])
          && (!('appearances' in e) || (e.appearances is int && e.appearances >= 0 && e.appearances <= 2000))
          && (!('goals' in e) || (e.goals is int && e.goals >= 0 && e.goals <= 2000))
          && (!('assists' in e) || (e.assists is int && e.assists >= 0 && e.assists <= 2000));
      }

      // Self sign-up from the public /join page. Drafts only: staff review the submission in
      // /admin/players, approve the files, then publish. Keep this shape in sync with
      // src/lib/player-signup.ts.
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'nickname', 'position', 'role', 'jerseyNumber', 'imageUrl', 'bio', 'stats',
            'strongFoot', 'careerHighlights', 'squadStatus', 'dob', 'heightCm', 'nationality',
            'strengths', 'readyForNextStep', 'currentClub', 'published', 'clubHistory',
            'signupSessionId', 'signupGallery', 'signupVideos', 'storageBytes', 'source',
            'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll([
            'name', 'position', 'role', 'jerseyNumber', 'imageUrl', 'bio', 'stats', 'strongFoot',
            'squadStatus', 'dob', 'heightCm', 'nationality', 'strengths', 'readyForNextStep',
            'published', 'signupSessionId', 'storageBytes', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.source == 'signup'
        && request.resource.data.published == false
        && request.resource.data.role == 'Player'
        && request.resource.data.squadStatus == 'current'
        && request.resource.data.readyForNextStep == false
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.position in ['Goalkeeper', 'Defender', 'Midfielder', 'Forward']
        && request.resource.data.strongFoot in ['Left', 'Right', 'Both']
        && request.resource.data.jerseyNumber is int && request.resource.data.jerseyNumber >= 0 && request.resource.data.jerseyNumber <= 99
        && request.resource.data.heightCm is int && request.resource.data.heightCm >= 100 && request.resource.data.heightCm <= 230
        && request.resource.data.dob is string && request.resource.data.dob.size() == 10
        && request.resource.data.nationality is string && request.resource.data.nationality.size() >= 2 && request.resource.data.nationality.size() <= 60
        && request.resource.data.bio is string && request.resource.data.bio.size() >= 20 && request.resource.data.bio.size() <= 1200
        && request.resource.data.stats is map
        && request.resource.data.stats.keys().hasOnly(['appearances', 'goals', 'assists'])
        && request.resource.data.stats.appearances == 0
        && request.resource.data.stats.goals == 0
        && request.resource.data.stats.assists == 0
        && request.resource.data.strengths is list && request.resource.data.strengths.size() >= 1 && request.resource.data.strengths.size() <= 12
        && (!('careerHighlights' in request.resource.data) || (request.resource.data.careerHighlights is list && request.resource.data.careerHighlights.size() <= 12))
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40))
        && (!('currentClub' in request.resource.data) || (request.resource.data.currentClub is string && request.resource.data.currentClub.size() <= 80))
        && (!('clubHistory' in request.resource.data) || (
              request.resource.data.clubHistory is list
              && request.resource.data.clubHistory.size() >= 1
              // Bounded at 5, not 8. Firestore caps the rules evaluation budget and this
              // create rule sits close to it: at a bound of 8, the eighth entry was rejected
              // for a realistic payload once the signupGallery/signupVideos empty-array
              // guards were added (verified empirically — 7 entries passed, 8 failed).
              // Fewer entries means fewer per-index guards, and that is the only headroom
              // available without dropping the per-entry `verified` check or the index-0
              // shape validation, both of which must hold. Keep in sync with MAX_CLUBS in
              // src/app/(public)/join/club-history-editor.tsx.
              && request.resource.data.clubHistory.size() <= 5
              // Full shape validation of the first entry.
              && validClubEntry(request.resource.data.clubHistory[0])
              // Security-critical check for the rest. Rules cannot loop, and running the full
              // validClubEntry on every entry blows the budget outright (verified empirically:
              // it rejects legitimate 2-entry submissions), so the remaining indices get the
              // cheap check that actually matters — a player must never be able to mark their
              // own claim as confirmed. Bump these guards if the bound above ever changes.
              && (request.resource.data.clubHistory.size() < 2 || request.resource.data.clubHistory[1].verified == false)
              && (request.resource.data.clubHistory.size() < 3 || request.resource.data.clubHistory[2].verified == false)
              && (request.resource.data.clubHistory.size() < 4 || request.resource.data.clubHistory[3].verified == false)
              && (request.resource.data.clubHistory.size() < 5 || request.resource.data.clubHistory[4].verified == false)))
        // Files must sit under the staging prefix for this exact session, so a crafted write
        // can't attach somebody else's object — or a published player's photo — to a profile.
        && request.resource.data.signupSessionId is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https://[^ ]+/signups/' + request.resource.data.signupSessionId + '/photo/[^ ]+$')
        // `size() == 0 ||` is load-bearing, not belt-and-braces: player-signup.ts always
        // writes these arrays (as [] when the player uploaded none), and indexing [0] out of
        // range makes the whole rule *error* rather than fail — which denied every photo-only
        // submission, the most common first case. Both arrays need it.
        && (!('signupGallery' in request.resource.data) || (
              request.resource.data.signupGallery is list && request.resource.data.signupGallery.size() <= 8
              && (request.resource.data.signupGallery.size() == 0
                  || request.resource.data.signupGallery[0].url.matches('^https://[^ ]+/signups/' + request.resource.data.signupSessionId + '/gallery/[^ ]+$'))))
        && (!('signupVideos' in request.resource.data) || (
              request.resource.data.signupVideos is list && request.resource.data.signupVideos.size() <= 4
              && (request.resource.data.signupVideos.size() == 0
                  || request.resource.data.signupVideos[0].url.matches('^https://[^ ]+/signups/' + request.resource.data.signupSessionId + '/video/[^ ]+$'))))
        // Note: only index 0 of the gallery/video arrays is pattern-checked. The rest are
        // length-bounded, and staff review every submission before it can be published —
        // that review is the backstop, not this line.
        && request.resource.data.storageBytes is int && request.resource.data.storageBytes >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow write: if isAdmin();
    }

    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy video collection (migrated to mediaAssets). Kept readable for old links.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if isAdmin();

      match /liveEvents/{eventId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /recaps/{recapId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teamProfile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────── v1 pathway collections: public only once published ─────────
    match /journeys/{journeyId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read: if get(/databases/$(database)/documents/journeys/$(journeyId)).data.published == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /mediaAssets/{assetId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /galleries/{galleryId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    // ───────── Enquiries: anyone can submit, only staff can read ─────────
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['role', 'name', 'email', 'phone', 'organisation', 'message', 'playerId', 'playerName', 'status', 'createdAt'])
        && request.resource.data.role in ['scout', 'parent', 'player', 'partner', 'media']
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ───────── Staff-only tools ─────────
    match /formations/{formationId} {
      allow read, write: if isAdmin();
    }

    match /playerVideos/{tagId} {
      allow read, write: if isAdmin();
    }

    match /userPushTokens/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
