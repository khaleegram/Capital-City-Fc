rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff are users with a document at admins/{uid}.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function isPublished() {
      return resource.data.published == true;
    }

    // ───────── Staff accounts ─────────
    match /admins/{uid} {
      // A user may read their own record (used by AdminGuard and server-side staff checks).
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isOwner()
        && request.resource.data.role in ['owner', 'editor'];
      // Owners can't delete themselves, so there's always at least one owner.
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // ───────── Always-public collections ─────────
    match /players/{playerId} {
      allow read: if true;

      // Self sign-up from the public /join page. Drafts only: staff review the submission in
      // /admin/players, set the official photo, then publish it. Keep this shape in sync with
      // src/lib/player-signup.ts.
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'nickname', 'position', 'role', 'jerseyNumber', 'imageUrl', 'bio', 'stats',
            'strongFoot', 'careerHighlights', 'squadStatus', 'dob', 'heightCm', 'nationality',
            'strengths', 'readyForNextStep', 'currentClub', 'published',
            'photoLink', 'videoLinks', 'contact', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll([
            'name', 'position', 'role', 'jerseyNumber', 'imageUrl', 'bio', 'stats', 'strongFoot',
            'squadStatus', 'dob', 'heightCm', 'nationality', 'strengths', 'readyForNextStep',
            'published', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.source == 'signup'
        && request.resource.data.published == false
        && request.resource.data.role == 'Player'
        && request.resource.data.squadStatus == 'current'
        && request.resource.data.readyForNextStep == false
        && request.resource.data.imageUrl == ''
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.position in ['Goalkeeper', 'Defender', 'Midfielder', 'Forward']
        && request.resource.data.strongFoot in ['Left', 'Right', 'Both']
        && request.resource.data.jerseyNumber is int && request.resource.data.jerseyNumber >= 0 && request.resource.data.jerseyNumber <= 99
        && request.resource.data.heightCm is int && request.resource.data.heightCm >= 100 && request.resource.data.heightCm <= 230
        && request.resource.data.dob is string && request.resource.data.dob.size() == 10
        && request.resource.data.nationality is string && request.resource.data.nationality.size() >= 2 && request.resource.data.nationality.size() <= 60
        && request.resource.data.bio is string && request.resource.data.bio.size() >= 20 && request.resource.data.bio.size() <= 1200
        && request.resource.data.stats is map
        && request.resource.data.stats.keys().hasOnly(['appearances', 'goals', 'assists'])
        && request.resource.data.stats.appearances == 0
        && request.resource.data.stats.goals == 0
        && request.resource.data.stats.assists == 0
        && request.resource.data.strengths is list && request.resource.data.strengths.size() >= 1 && request.resource.data.strengths.size() <= 12
        && (!('careerHighlights' in request.resource.data) || (request.resource.data.careerHighlights is list && request.resource.data.careerHighlights.size() <= 12))
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40))
        && (!('currentClub' in request.resource.data) || (request.resource.data.currentClub is string && request.resource.data.currentClub.size() <= 80))
        && (!('photoLink' in request.resource.data) || (request.resource.data.photoLink is string && request.resource.data.photoLink.size() <= 500))
        && (!('videoLinks' in request.resource.data) || (request.resource.data.videoLinks is list && request.resource.data.videoLinks.size() <= 5))
        && (!('contact' in request.resource.data) || (
              request.resource.data.contact is map
              && request.resource.data.contact.keys().hasOnly(['email', 'phone'])
              && (!('email' in request.resource.data.contact) || (request.resource.data.contact.email is string && request.resource.data.contact.email.size() <= 200))
              && (!('phone' in request.resource.data.contact) || (request.resource.data.contact.phone is string && request.resource.data.contact.phone.size() <= 40))))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow write: if isAdmin();
    }

    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy video collection (migrated to mediaAssets). Kept readable for old links.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if isAdmin();

      match /liveEvents/{eventId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /recaps/{recapId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teamProfile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────── v1 pathway collections: public only once published ─────────
    match /journeys/{journeyId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read: if get(/databases/$(database)/documents/journeys/$(journeyId)).data.published == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /mediaAssets/{assetId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /galleries/{galleryId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    // ───────── Enquiries: anyone can submit, only staff can read ─────────
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['role', 'name', 'email', 'phone', 'organisation', 'message', 'playerId', 'playerName', 'status', 'createdAt'])
        && request.resource.data.role in ['scout', 'parent', 'player', 'partner', 'media']
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ───────── Staff-only tools ─────────
    match /formations/{formationId} {
      allow read, write: if isAdmin();
    }

    match /playerVideos/{tagId} {
      allow read, write: if isAdmin();
    }

    match /userPushTokens/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
